# Database
DATABASE_URL=postgres://postgres:password@localhost:5434/subscription_tracker?sslmode=disable

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend
FRONTEND_URL=http://localhost:3000

# Google OAuth (Calendar integration)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# AI Service
AI_SERVICE_URL=http://localhost:8000

# M-Pesa (Get from https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/payment/mpesa/callback

# Paystack (Get from https://paystack.com)
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# ======================================
# EMAIL NOTIFICATIONS - Choose ONE method
# ======================================

# METHOD 1: Gmail with OAuth2 (Recommended for Gmail)
# Follow GMAIL_OAUTH_SETUP.md to get these values
GMAIL_CLIENT_ID=your-oauth2-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-oauth2-client-secret
GMAIL_REFRESH_TOKEN=your-oauth2-refresh-token
GMAIL_EMAIL=your-email@gmail.com

# METHOD 2: Standard SMTP (For Outlook, Yahoo, SendGrid, Mailtrap)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password-or-password

# SMTP Examples:
# Outlook: smtp.office365.com:587
# Yahoo: smtp.mail.yahoo.com:587
# SendGrid: smtp.sendgrid.net:587
# Mailtrap (testing): sandbox.smtp.mailtrap.io:2525
